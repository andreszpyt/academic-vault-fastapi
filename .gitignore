# =========================================
# Bytecode e Cache Python
# =========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# =========================================
# Ambientes Virtuais
# =========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# =========================================
# Variáveis de Ambiente e Segredos
# =========================================
.env
.env.*
!.env.example

# =========================================
# IDEs e Editores de Código
# =========================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# =========================================
# Logs e Arquivos de Execução
# =========================================
*.log
logs/

# =========================================
# Armazenamento e Uploads Locais (Storage)
# Ignora arquivos gerados/salvos, mantendo estrutura se houver .gitkeep
# =========================================
storage/logs/*
!storage/logs/.gitkeep

storage/documentos/*
!storage/documentos/.gitkeep

# Se os metadados forem dados de runtime locais, ignore-os também:
# storage/metadata/*
# !storage/metadata/.gitkeep

# =========================================
# Testes, Cobertura e Análise Estática
# =========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
/app/__pycache__/*

# =========================================
# Builds, Pacotes e Distribuição
# =========================================
build/
dist/
*.egg-info/
.eggs/
*.egg

# =========================================
