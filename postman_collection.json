                {
                  "key": "extensao",
                  "value": ".pdf",
                  "description": "Filtra por extensão do arquivo (ex: .pdf, .docx, .jpg, .txt)"
                },
                {
                  "key": "aluno",
                  "value": "",
                  "disabled": true,
                  "description": "Busca parcial por nome do aluno"
                },
                {
                  "key": "autor",
                  "value": "",
                  "disabled": true,
                  "description": "Alias para busca por aluno/autor"
