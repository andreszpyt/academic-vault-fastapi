            "url": {
              "raw": "{{base_url}}/documentos/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documentos",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID numérico do documento"
                }
              ]
            },
            "description": "Retorna todos os metadados cadastrados de um documento específico pelo seu identificador."
          },
          "response": []
        },
        {
          "name": "Download do Arquivo Binário (F4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documentos/:id/download",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documentos",
                ":id",
                "download"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID numérico do documento"
                }
              ]
            },
            "description": "Faz o download do arquivo físico armazenado com o Content-Type apropriado e nome original."
          },
          "response": []
        },
        {
          "name": "Atualizar Metadados do Documento (F5)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoria\": \"academico\",\n  \"descricao\": \"Descrição atualizada com revisão e correção das referências bibliográficas.\",\n  \"aluno\": \"Ian Silva Santos\",\n  \"matricula\": \"2023010198\",\n  \"curso\": \"Ciência da Computação\",\n  \"semestre\": \"2026.2\",\n  \"tipo_documento\": \"tcc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documentos/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documentos",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID numérico do documento"
                }
              ]
            },
            "description": "Atualiza campos mutáveis de metadados. Campos estruturais como id, sha256, tamanho e nome_armazenado permanecem protegidos."
          },
          "response": []
        },
        {
          "name": "Excluir Documento (F6)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documentos/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documentos",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID numérico do documento a ser excluído"
                }
              ]
            },
            "description": "Remove permanentemente o arquivo binário do disco e exclui o registro correspondente no catálogo JSON."
          },
          "response": []
        }
      ]
    },
    {
