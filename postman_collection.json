                {
                  "key": "ano_publicacao",
                  "value": "",
                  "disabled": true,
                  "description": "Alias para busca por ano"
                },
                {
                  "key": "tipo_documento",
                  "value": "",
                  "disabled": true,
                  "description": "Filtra por tipo (ex: tcc, historico, artigo, certificado)"
                },
                {
                  "key": "curso",
                  "value": "Ciência da Computação",
                  "description": "Busca parcial por curso"
                },
                {
                  "key": "palavra_chave",
                  "value": "",
                  "disabled": true,
                  "description": "Busca textual ampla em nome, descrição e aluno"
                },
                {
                  "key": "termo",
                  "value": "",
                  "disabled": true,
                  "description": "Alias para busca textual"
                },
                {
                  "key": "descricao",
                  "value": "",
                  "disabled": true,
                  "description": "Busca parcial na descrição"
                },
                {
                  "key": "nome_original",
                  "value": "",
                  "disabled": true,
                  "description": "Busca parcial no nome original do arquivo"
                },
                {
                  "key": "titulo",
                  "value": "",
                  "disabled": true,
                  "description": "Alias para busca por nome original"
                },
                {
                  "key": "tipo_mime",
                  "value": "",
                  "disabled": true,
                  "description": "Filtra por tipo MIME (ex: application/pdf)"
                }
              ]
            },
            "description": "Retorna a listagem de todos os documentos cadastrados, permitindo múltiplos filtros combinados."
          },
          "response": []
        },
        {
          "name": "Consultar Documento por ID (F3)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
