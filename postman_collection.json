{
  "info": {
    "_postman_id": "a91e57c2-84b1-4f1b-96cb-8b5e28a49c3e",
    "name": "Cofre de Documentos Acadêmicos - API",
    "description": "Coleção completa de endpoints para a API do Cofre Digital de Documentos Acadêmicos (FastAPI).\n\nInclui:\n- CRUD e download de documentos físicos e metadados\n- Pesquisa avançada combinatória (regras de atributos gerais e específicos)\n- Estatísticas do acervo e métricas de armazenamento\n- Verificação de integridade via cálculo de hash SHA-256 (individual e global)\n- Exportações em formatos tabulares e estruturados (CSV e XML)\n- Criação, listagem e download de backups compactados (.ZIP)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "URL base da API FastAPI"
    }
  ],
  "item": [
    {
      "name": "Geral",
      "description": "Endpoints gerais do sistema",
      "item": [
        {
          "name": "Raiz / Informações da API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Retorna informações básicas do sistema, versão e link para documentação interativa (/docs)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documentos",
      "description": "Operações de gerenciamento, upload, consulta, atualização e exclusão de documentos acadêmicos.",
      "item": [
        {
          "name": "Upload de Documento (F1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "type": "file",
                  "description": "Arquivo físico a ser enviado (ex: PDF, DOCX, JPG, TXT)",
                  "src": []
                },
                {
                  "key": "categoria",
                  "value": "academico",
                  "type": "text",
                  "description": "Categoria do documento (ex: academico, administrativo, financeiro, outros)"
                },
                {
                  "key": "aluno",
                  "value": "Ian Silva Santos",
                  "type": "text",
                  "description": "Nome completo do aluno proprietário do documento"
                },
                {
                  "key": "matricula",
                  "value": "2023010198",
                  "type": "text",
                  "description": "Número de matrícula do estudante"
                },
                {
                  "key": "curso",
                  "value": "Ciência da Computação",
                  "type": "text",
                  "description": "Curso do estudante"
                },
                {
                  "key": "semestre",
                  "value": "2026.1",
                  "type": "text",
                  "description": "Semestre de referência (ex: 2026.1)"
                },
                {
                  "key": "tipo_documento",
                  "value": "tcc",
                  "type": "text",
                  "description": "Tipo do documento (ex: tcc, historico, certificado, declaracao, artigo, relatorio)"
                },
                {
                  "key": "descricao",
                  "value": "Trabalho de Conclusão de Curso focado em microsserviços e persistência em arquivos.",
                  "type": "text",
                  "description": "Descrição opcional detalhada do documento"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documentos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documentos"
              ]
            },
            "description": "Realiza o upload do arquivo binário e indexação dos metadados com cálculo automático de hash SHA-256 e tipo MIME."
          },
          "response": []
        },
        {
          "name": "Listar Documentos com Filtros (F2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documentos?categoria=academico&extensao=.pdf&curso=Ciência da Computação&semestre=2026.1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documentos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "academico",
                  "description": "Filtra por categoria (ex: academico, administrativo)"
